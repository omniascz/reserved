{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*"],
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": ["DATABASE_URL", "DATABASE_APP_URL", "API_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "CALDAV_TEST_URL",
        "CALDAV_TEST_USER",
        "CALDAV_TEST_PASSWORD",
        "STRIPE_MOCK_URL",
        "STRIPE_API_BASE",
        "STRIPE_FAKE_PORT",
        "CALENDAR_FAKE_PORT",
        "PAYMENT_CONFIG_KEY",
        "CALENDAR_PUSH_SECRET",
        "GOOGLE_API_BASE",
        "MICROSOFT_GRAPH_BASE"
      ]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false,
      "outputs": ["drizzle/**"]
    },
    "db:migrate": {
      "cache": false
    }
  }
}
