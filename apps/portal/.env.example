# Reserved klientský portál (apps/portal, port 4003) — zkopíruj na apps/portal/.env.local
NEXT_PUBLIC_API_URL=http://localhost:4010/api/v1
# Automatické přihlášení v dev režimu (komponenta DevAutoLogin).
# Bez těchto proměnných se nic nepřihlašuje. Hodnoty odpovídají seedu
# `tsx src/seed-demo-customer.ts` v packages/db.
NEXT_PUBLIC_DEV_LOGIN_EMAIL=jan@demo.local
NEXT_PUBLIC_DEV_LOGIN_PASSWORD=heslo123

# NEXT_PUBLIC_SENTRY_DSN=
# Jen pro build s nahráním source map do Sentry:
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
