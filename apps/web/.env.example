# Reserved admin (apps/web, port 4002) — zkopíruj na apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:4010/api/v1
NEXT_PUBLIC_WIDGET_URL=http://localhost:4004
NEXT_PUBLIC_TENANT_SITE_URL=http://localhost:4006
# Automatické přihlášení v dev režimu (DevAutoLogin) a předvyplnění
# přihlašovacího formuláře. Bez těchto proměnných se nic nepřihlašuje a
# formulář je PRÁZDNÝ. Hodnoty odpovídají `pnpm db:seed`.
# V produkci nechat prázdné — v produkčním běhu se nepředvyplní nic tak jako tak.
NEXT_PUBLIC_DEV_LOGIN_SLUG=demo
NEXT_PUBLIC_DEV_LOGIN_EMAIL=admin@demo.local
NEXT_PUBLIC_DEV_LOGIN_PASSWORD=admin123

# NEXT_PUBLIC_SENTRY_DSN=
# Jen pro build s nahráním source map do Sentry:
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
