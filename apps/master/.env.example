# Reserved master admin (apps/master, port 4001) — zkopíruj na apps/master/.env.local
NEXT_PUBLIC_API_URL=http://localhost:4010/api/v1
NEXT_PUBLIC_ADMIN_BASE_URL=http://localhost:4002
# Automatické přihlášení v dev režimu (komponenta DevAutoLogin).
# Bez těchto proměnných se nic nepřihlašuje. Nejsou tu žádné demo hodnoty:
# master admin není uživatel tenanta — musí odpovídat tomu, co jsi zadal do
# PLATFORM_ADMIN_EMAIL / PLATFORM_ADMIN_PASSWORD při seedu seed-platform-admin.ts.
# NEXT_PUBLIC_DEV_LOGIN_EMAIL=
# NEXT_PUBLIC_DEV_LOGIN_PASSWORD=

# NEXT_PUBLIC_SENTRY_DSN=
# Jen pro build s nahráním source map do Sentry:
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
