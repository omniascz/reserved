# Reserved workers — zkopíruj na apps/workers/.env  (cp .env.example .env)
# Workers pollují frontu v Postgresu (notifikace, expirace slot holdů, narozeniny).
# Redis se nepoužívá. Nepovinné proměnné jsou zakomentované.

NODE_ENV=development
# Vlastník schématu (migrace). Workers samy migrace nespouštějí, ale drží se
# stejného rozdělení jako API: vlastník pro schéma, app_user pro běh.
DATABASE_URL=postgresql://dev:dev@localhost:5433/reserved_dev
DATABASE_APP_URL=postgresql://app_user:reserved_dev_app_2026@localhost:5433/reserved_dev
# WORKER_NOTIFICATION_TICK_SECONDS=5
# WORKER_HOLD_EXPIRY_TICK_SECONDS=30

# E-mail (Mailhog v dev: SMTP 1026, UI http://localhost:8026)
SMTP_HOST=localhost
SMTP_PORT=1026
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=noreply@reserved.local
EMAIL_FROM_NAME=Reserved

# SMS a WhatsApp: mock (jen log) nebo bulkgate
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
# BULKGATE_APP_ID=
# BULKGATE_APP_TOKEN=
# BULKGATE_SENDER=Reserved
# BULKGATE_WHATSAPP_FROM=
