# =============================================================================
# Reserved API — proměnné prostředí (šablona)
# =============================================================================
# Zkopíruj do apps/api/.env:   cp .env.example apps/api/.env
# apps/api/.env a .env.local jsou v .gitignore — NIKDY necommituj credentials.
# Workers: apps/workers/.env.example · Frontendy: apps/<app>/.env.example
#
# Nepovinné proměnné jsou zakomentované. Nenastavuj je na prázdný řetězec —
# "" není totéž co "nenastaveno" (URL validace by API shodila při startu).
# =============================================================================

NODE_ENV=development

# ─── API a URL aplikací ──────────────────────────────────────────────────────
API_PORT=4010
# Vlastní base URL API BEZ /api/v1 (odkazy v iCal feedu, uploadech…)
API_URL=http://localhost:4010
# Admin (apps/web) — v produkci zároveň jediný povolený CORS origin
APP_URL=http://localhost:4002
# Odkazy v e-mailech a přesměrování (výchozí hodnoty viz kód)
# ADMIN_BASE_URL=http://localhost:4002
# PORTAL_BASE_URL=http://localhost:4003
# MASTER_BASE_URL=http://localhost:4001
# Veřejná URL API pro OAuth redirecty (Stripe Connect)
# API_PUBLIC_URL=http://localhost:4010

# ─── PostgreSQL (docker-compose.dev.yml, port 5433) ──────────────────────────
# DATABASE_URL     — vlastník (dev/superuser): migrace, seed, drizzle-kit. Obchází RLS.
# DATABASE_APP_URL — běžící API (app_user, bez superuser práv): RLS se na něj vztahuje.
DATABASE_URL=postgresql://dev:dev@localhost:5433/reserved_dev
DATABASE_APP_URL=postgresql://app_user:app@localhost:5433/reserved_dev
# DATABASE_POOL_MAX=10

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Min. 32 znaků. Vygeneruj: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev_only_change_me_to_random_secret_min_32_chars
JWT_ISSUER=reserved
JWT_AUDIENCE=reserved-api
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=604800

# ─── Rozpoznání tenanta ──────────────────────────────────────────────────────
APP_BASE_DOMAIN=localhost
# APP_RESERVED_SUBDOMAINS=app,www,api,admin,static,cdn
# Cíl CNAME pro vlastní domény tenantů
# RESERVED_CNAME_TARGET=

# ─── E-mail (Mailhog v dev: SMTP 1026, UI http://localhost:8026) ─────────────
SMTP_HOST=localhost
SMTP_PORT=1026
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=noreply@reserved.local
EMAIL_FROM_NAME=Reserved

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Platby koncových klientů přes Stripe Connect:
# STRIPE_SECRET_KEY=
# STRIPE_CONNECT_CLIENT_ID=
# Předplatné tenantů (platform billing):
# STRIPE_PLATFORM_SECRET_KEY=
# STRIPE_PLATFORM_WEBHOOK_SECRET=
# CZ brány (GoPay, Comgate, ThePay, PayU, GP webpay) se nastavují per tenant
# v DB (payment_methods.config), ne tady.

# ─── Google Calendar OAuth ───────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4010/api/v1/admin/integrations/google/callback
# GOOGLE_STATE_SECRET=

# ─── Soubory (S3 / Cloudflare R2). Bez S3_* se ukládá lokálně do UPLOADS_DIR ──
# UPLOADS_DIR=
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE=

# ─── Monitoring ──────────────────────────────────────────────────────────────
# SENTRY_DSN=
# GIT_SHA=

# ─── Seed master admina (packages/db/src/seed-platform-admin.ts) ─────────────
# E-mail i heslo jsou POVINNÉ — bez nich seed skončí chybou (v kódu nejsou defaulty).
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_ADMIN_FIRST_NAME=
# PLATFORM_ADMIN_LAST_NAME=
