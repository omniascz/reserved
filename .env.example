# =============================================================================
# Reserved — environment variables
# =============================================================================
# Zkopíruj na .env.local (lokální dev) a vyplň skutečné hodnoty.
# .env.local je v .gitignore, NIKDY neсommituj credentials.
# =============================================================================

NODE_ENV=development

# ─── Aplikace ────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
API_PORT=3001
API_URL=http://localhost:3001

# ─── PostgreSQL (Docker compose dev) ─────────────────────────────────────────
DATABASE_URL=postgresql://dev:dev@localhost:5432/reserved_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─── Redis (Docker compose dev) ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generuj přes: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_me_with_64_random_bytes_hex
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
JWT_ISSUER=reserved
JWT_AUDIENCE=reserved-api

# ─── Tenant resolution ───────────────────────────────────────────────────────
APP_BASE_DOMAIN=localhost
APP_PROTOCOL=http

# ─── Email (Mailhog v dev, Postmark v prod) ──────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@reserved.local
EMAIL_FROM_NAME=Reserved

# ─── Stripe (sprint 2.1) ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# ─── GoPay (alternativa Stripe pro CZ trh) ────────────────────────────────────
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_GOID=
GOPAY_API_URL=https://gw.sandbox.gopay.com/api
GOPAY_WEBHOOK_IP_ALLOWLIST=

# ─── SMS (Twilio nebo BulkGate, sprint 2.2) ──────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
BULKGATE_APPLICATION_ID=
BULKGATE_APPLICATION_TOKEN=

# ─── Storage (Cloudflare R2, později) ────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ─── Monitoring (Sentry, sprint 2 / fáze 1 launch) ───────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ─── Internal service-to-service auth ────────────────────────────────────────
# Token pro ochranu internal API (např. /api/internal/order-completed).
INTERNAL_SERVICE_TOKEN=replace_me_with_random_secret
INTERNAL_API_BASE_URL=http://localhost:3001
