# Proměnné pro ZKUŠEBNÍ běh nanečisto (docker-compose.nanecisto.yml).
#
# ── TENHLE SOUBOR SMÍ BÝT V REPOZITÁŘI ──────────────────────────────────────
# Není v něm nic tajného. Všechny hodnoty jsou jednorázové a platí jen pro
# lokální zkoušku na vývojářském stroji — databáze běží v kontejneru, který se
# po zkoušce zahodí, a ven z něj nevede žádný port do internetu.
#
# Produkční hodnoty patří do `.env` (ten je v .gitignore) podle šablony
# `.env.production.example`. Tenhle soubor se s ním NESMÍ zaměnit.
#
# Spuštění:
#   docker compose --env-file .env.nanecisto \
#     -f docker-compose.prod.yml -f docker-compose.nanecisto.yml up -d --build

# ─── Doména ──────────────────────────────────────────────────────────────────
# Vymyšlená lokální doména. Používá ji proxy pro směrování podle názvu
# hostitele; testuje se přes hlavičku Host, takže ji netřeba nikam zapisovat.
BASE_DOMAIN=reserved.local
# Produkční sestava e-mail vyžaduje (Let's Encrypt), lokálně se nepoužije:
# zkušební proxy má vydávání certifikátů vypnuté.
ACME_EMAIL=nanecisto@reserved.local

# ─── Databáze ────────────────────────────────────────────────────────────────
POSTGRES_DB=reserved
POSTGRES_USER=reserved_owner
POSTGRES_PASSWORD=nanecisto_db_heslo_2026

# Vlastník schématu — migrace a plnění daty. Obchází izolaci tenantů.
DATABASE_URL=postgresql://reserved_owner:nanecisto_db_heslo_2026@db:5432/reserved
# Aplikační role — běžící API a workers. Izolace tenantů se na ni vztahuje.
# Heslo se MUSÍ shodovat s APP_USER_PASSWORD níže, jinak se API nepřipojí.
DATABASE_APP_URL=postgresql://app_user:nanecisto_app_heslo_2026@db:5432/reserved
APP_USER_PASSWORD=nanecisto_app_heslo_2026

# ─── Tajemství (jednorázová, jen pro zkoušku) ────────────────────────────────
# Musí mít aspoň 32 znaků, jinak API nenastartuje.
JWT_SECRET=nanecisto_pouze_lokalni_podpis_tokenu_2026
# Přesně 32 bajtů = 64 hex znaků. V uvozovkách to tu být nemusí (není to YAML),
# ale v CI konfiguracích ANO — tam by se samé číslice přečetly jako číslo.
PAYMENT_CONFIG_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90

# ─── E-maily ─────────────────────────────────────────────────────────────────
# Míří na Mailhog v téže síti. Web pro čtení: http://localhost:8027
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@reserved.local
EMAIL_FROM_NAME=Reserved nanečisto

# ─── SMS ─────────────────────────────────────────────────────────────────────
SMS_PROVIDER=mock

# ─── Úložiště souborů ────────────────────────────────────────────────────────
# Záměrně prázdné: zkouší se právě to, co se stane BEZ S3 — tedy jestli
# nahrané soubory přežijí restart kontejneru.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE=

# ─── Monitoring ──────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
GIT_SHA=nanecisto
