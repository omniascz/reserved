# =============================================================================
# Reserved — produkční proměnné (šablona pro docker-compose.prod.yml)
# =============================================================================
# Zkopíruj:  cp .env.production.example .env   a vyplň.
# .env NIKDY necommituj.
#
# ── DOMÉNA JE JEDINÁ PROMĚNNÁ ────────────────────────────────────────────────
# Nikde v repozitáři není doména natvrdo. Všechny adresy se skládají odsud:
#   api.<doména>, app.<doména>, portal.<doména>, widget.<doména>,
#   master.<doména> a holá <doména> pro marketing.
# =============================================================================

# Doména bez protokolu a bez www, např. reserved.app
BASE_DOMAIN=
# E-mail pro Let's Encrypt (upozornění na vypršení certifikátu)
ACME_EMAIL=

# ─── Databáze ────────────────────────────────────────────────────────────────
# DATABASE_URL     — vlastník schématu: migrace a seed. Obchází izolaci tenantů.
# DATABASE_APP_URL — běžící aplikace (role app_user). Izolace se na ni vztahuje.
# POZOR: bez DATABASE_APP_URL běží API jako vlastník databáze a izolace mezi
# zákazníky se NEUPLATNÍ. Není to volitelná optimalizace.
DATABASE_URL=postgresql://vlastnik:heslo@db-host:5432/reserved
DATABASE_APP_URL=postgresql://app_user:heslo@db-host:5432/reserved

# Heslo role app_user. POVINNÉ pro migraci — bez něj skončí chybou.
# Musí se shodovat s heslem uvnitř DATABASE_APP_URL.
# Vygeneruj: openssl rand -base64 24
APP_USER_PASSWORD=

# ─── Tajemství ───────────────────────────────────────────────────────────────
# Podpis přihlašovacích tokenů, min. 32 znaků. openssl rand -hex 32
JWT_SECRET=

# Šifrování přístupů k platebním bránám (merchant ID i tajné klíče).
# Přesně 32 bajtů: 64 hex znaků. openssl rand -hex 32
#
# ⚠️ ZÁLOHUJ ODDĚLENĚ OD DATABÁZE. Při ztrátě klíče se uložené přístupy
# k branám už nedešifrují a provozovatelé je musí zadat znovu. Naopak právě
# proto je únik samotné databáze bez klíče k ničemu.
PAYMENT_CONFIG_KEY=

# ─── Odesílání e-mailů ───────────────────────────────────────────────────────
# Bez tohohle neodejde ověření adresy, potvrzení rezervace ani upozornění
# na zamčený účet. Výchozí hodnoty v kódu míří na vývojový Mailhog.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@
EMAIL_FROM_NAME=Reserved

# ─── SMS (volitelné) ─────────────────────────────────────────────────────────
# Při SMS_PROVIDER=bulkgate jsou ID i token POVINNÉ, jinak workers spadnou
# při startu.
SMS_PROVIDER=mock
BULKGATE_APP_ID=
BULKGATE_APP_TOKEN=
BULKGATE_SENDER=Reserved

# ─── Povolené adresy pro volání z prohlížeče (CORS) ──────────────────────────
# Adresy aplikací se skládají z BASE_DOMAIN automaticky a subdomény základní
# domény (včetně subdomén tenantů) se povolují samy.
#
# Sem patří jen VLASTNÍ DOMÉNY TENANTŮ — ty jsou uložené v databázi
# (tenants.custom_domain), ale seznam se skládá při startu aplikace a z databáze
# se nenačítá. Bez doplnění by zákazníkovi na vlastní doméně nefungovala
# rezervace. Oddělovač je čárka, adresa včetně https:// a bez lomítka na konci.
CORS_EXTRA_ORIGINS=

# ─── Úložiště souborů (doporučené) ───────────────────────────────────────────
# Bez S3 se obrázky ukládají na disk. Sestava pro ně má svazek `uploads_data`,
# takže restart ani nasazení je nesmaže — ale je to jen záchranná síť:
# svazek na jednom serveru se nezálohuje sám a při přesunu na jiný stroj
# zůstane na místě. Pro ostrý provoz zůstává doporučené S3.
# Musí být vyplněno všech šest, jinak se použije lokální disk.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE=

# ─── Monitoring (volitelné) ──────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
GIT_SHA=

# ─── Vlastní databáze v kontejneru (jen pro --profile s-databazi) ────────────
# POSTGRES_DB=reserved
# POSTGRES_USER=reserved
# POSTGRES_PASSWORD=
